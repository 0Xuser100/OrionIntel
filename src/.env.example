APP_NAME="OrionIntel"
APP_VENDOR="Virello"
APP_VERSION="0.1"
FILE_ALLOWED_TYPES= ["text/plain","application/pdf"]

FILE_MAX_SIZE=10 #MB
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB


#========================= mongodb config=========================
# Local (run app on host):   mongodb://username:password@localhost:27007
# Docker (app in container):  mongodb://username:password@mongodb:27017
# In Docker, host = the compose service name "mongodb" and the INTERNAL port 27017.
# The username/password MUST match docker/.env (MONGO_INITDB_ROOT_USERNAME/PASSWORD).
MONGODB_URL="mongodb://username:password@mongodb:27017"
MONGODB_DATABASE="name of database"

#======================== postgres config=========================
# Local (run app on host):   HOST=localhost, PORT=5433 (host port published by docker-compose)
# Docker (app in container):  HOST=pgvector,  PORT=5432 (compose service name + internal port)
# Full URL form (async SQLAlchemy):
#   postgresql+asyncpg://username:password@localhost:5433/database   (local)
#   postgresql+asyncpg://username:password@pgvector:5432/database    (in Docker)
# NOTE: "@" in the password is URL-encoded as "%40" inside the full URL.
# The username/password MUST match docker/.env (POSTGRES_USER/POSTGRES_PASSWORD).
POSTGRES_USERNAME=""
POSTGRES_PASSWORD=""
POSTGRES_HOST=""
POSTGRES_PORT=
POSTGRES_MAIN_DATABASE=""

# ========================= LLM Config =========================
GENERATION_BACKEND = "OPENAI"
EMBEDDING_BACKEND = "COHERE"


OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""

GENERATION_MODEL_ID_LITERAL = ["gpt-4o-mini", "gpt-4o","gpt-4.1-mini-2025-04-14"]
GENERATION_MODEL_ID="gpt-4o-mini"
EMBEDDING_MODEL_ID="text-embedding-3-small"
EMBEDDING_MODEL_SIZE=384


INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1


# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND_LITERAL = ["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_DISTANCE_METHOD="cosine"

# Choose ONE mode:
# 1) Embedded (local dev): leave VECTOR_DB_URL empty and set a local path.
VECTOR_DB_PATH="qdrant_db"
# 2) Server (Docker): point at the qdrant container. When set, this WINS over the path.
VECTOR_DB_URL="http://qdrant:6333"

VECTOR_DB_PGVEC_INDEX_THRESHOLD=100
# ========================= Template Configs =========================
PRIMARY_LANG = "en"
DEFAULT_LANG = "en"

# ========================= Celery Task Queue Config =========================
# BROKER = RabbitMQ (where tasks are queued). Format:
#   amqp://<user>:<password>@<host>:<port>/<vhost>
# Local (app on host):   host=localhost, port=5672
# Docker (app in compose): host=rabbitmq, port=5672  (service name + internal port)
# user/password/vhost MUST match docker/env/.env.rabbitmq
CELERY_BROKER_URL="amqp://orionintel_user:orionintel_rabbitmq_2222@rabbitmq:5672/orionintel_vhost"

# BACKEND = Redis (where task states / return values are stored). Format:
#   redis://:<password>@<host>:<port>/<db-number>
# Note the leading ":" — Redis has no username, only a password.
# Local: localhost:6379 | Docker: redis:6379
# password MUST match REDIS_PASSWORD in docker/.env and docker/env/.env.redis
CELERY_RESULT_BACKEND="redis://:orionintel_redis_2222@redis:6379/0"

CELERY_TASK_SERIALIZER="json"     # never "pickle" (remote code execution risk)
CELERY_TASK_TIME_LIMIT=600        # seconds; hard kill for a hung task
CELERY_TASK_ACKS_LATE=true        # ack after the task finishes -> no task loss on crash
CELERY_WORKER_CONCURRENCY=2       # parallel task slots per worker process
CELERY_RESULT_EXPIRES=3600        # seconds a result stays in Redis

# ---- Flower dashboard (http://localhost:5555, user "admin") ----
CELERY_FLOWER_PASSWORD="orionintel_flower_2222"

# ---- Celery Beat periodic cleanup of the celery_task_executions table ----
# INTERVAL: how often the cleanup task is published (seconds).
# RETENTION: rows older than this are deleted (seconds).
# Production defaults below (hourly sweep, 24h history). For a LIVE DEMO of beat,
# set INTERVAL=10 and RETENTION=30 — but note retention also bounds how long
# idempotency protection lasts, so don't leave it that low.
CELERY_BEAT_CLEANUP_INTERVAL=3600
CELERY_TASK_RECORD_RETENTION=86400
