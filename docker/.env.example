# Compose-level variables.
#
# docker compose automatically reads a file named `.env` sitting next to
# docker-compose.yml and uses it for ${VAR} interpolation INSIDE the compose
# file itself. That is different from `env_file:`, which injects variables into
# a container's environment and is NOT visible to compose interpolation.
#
# We need this file because the redis service passes its password on the
# command line:  command: [..., "--requirepass", "${REDIS_PASSWORD}"]
#
# Keep this value identical to:
#   - docker/env/.env.redis           (REDIS_PASSWORD)
#   - docker/env/.env.app             (inside CELERY_RESULT_BACKEND)
REDIS_PASSWORD=orionintel_redis_2222
