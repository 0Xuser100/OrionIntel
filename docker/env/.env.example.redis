# Redis configuration for the Celery RESULT BACKEND.
#
# IMPORTANT: the redis image does NOT read REDIS_PASSWORD by itself. The
# password is applied through `--requirepass` in the compose `command:`, which
# reads it from docker/.env (compose-level interpolation), not from this file.
# Keep the value here identical to docker/.env and to CELERY_RESULT_BACKEND
# in ./env/.env.app:  redis://:REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=orionintel_redis_2222

# Append-only file: every write is journaled, so results survive a restart.
# Also passed explicitly as `--appendonly yes` in the compose command.
REDIS_APPENDONLY=yes

# Memory cap + what to evict when it's reached. allkeys-lru drops the
# least-recently-used keys, which for us means the oldest task results.
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Protected mode refuses connections from outside localhost when no password
# is set. We do set one, but keep it on as a safety net.
REDIS_PROTECTED_MODE=yes
