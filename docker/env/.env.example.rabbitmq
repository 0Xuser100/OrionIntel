# RabbitMQ container init variables (read by the official image on FIRST boot only).
# If you change these after the volume exists, run `docker compose down -v` for
# rabbitmq or the old credentials stay in rabbitmq_data.
#
# These three MUST match CELERY_BROKER_URL in ./env/.env.app:
#   amqp://RABBITMQ_DEFAULT_USER:RABBITMQ_DEFAULT_PASS@rabbitmq:5672/RABBITMQ_DEFAULT_VHOST
RABBITMQ_DEFAULT_USER=orionintel_user
RABBITMQ_DEFAULT_PASS=orionintel_rabbitmq_2222

# A vhost is a namespace: queues/exchanges inside it are invisible to other
# vhosts. Keeps OrionIntel's queues separate if the broker is ever shared.
RABBITMQ_DEFAULT_VHOST=orionintel_vhost

# Management plugin (the web UI on :15672). Already baked into the
# "-management-alpine" image tag; this flag is just documentation.
RABBITMQ_MANAGEMENT_ENABLED=true

# Authentication backend: internal = credentials stored in RabbitMQ itself
# (no LDAP / external auth).
RABBITMQ_AUTH_BACKENDS=rabbit_auth_backend_internal

# Refuse to accept new messages when free disk drops under 2 GB, instead of
# filling the disk and corrupting the node. (bytes)
RABBITMQ_DISK_FREE_LIMIT=2000000000
